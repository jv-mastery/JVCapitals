<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Your Account</title>
</head>
<body style="margin: 0; padding: 0; background-color: #121214; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; width: 100% !important;">
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #121214; padding: 40px 20px;">
    <tr>
      <td align="center">
        <!-- Main Card -->
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; background-color: #1e1e24; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);">
          
          <!-- Header Accent -->
          <tr>
            <td style="background-color: #fb2c36; height: 4px;"></td>
          </tr>
          
          <!-- Body Content -->
          <tr>
            <td style="padding: 40px 32px;">
              <h2 style="margin-top: 0; margin-bottom: 16px; color: #ffffff; font-size: 24px; font-weight: 700; line-height: 32px;">Welcome aboard!</h2>
              
              <p style="margin-top: 0; margin-bottom: 24px; color: #9ca3af; font-size: 16px; line-height: 24px;">
                Hi {{name}},
              </p>
              
              <p style="margin-top: 0; margin-bottom: 24px; color: #9ca3af; font-size: 16px; line-height: 24px;">
                Thank you for signing up. To complete your account registration and activate your access, please confirm your email address by clicking the button below:
              </p>
              
              <!-- Action Button -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
                <tr>
                  <td align="center" style="background-color: #fb2c36; border-radius: 6px;">
                    <a href="{{verifyLink}}" target="_blank" style="display: inline-block; padding: 14px 28px; font-size: 16px; font-weight: 600; color: #ffffff; text-decoration: none; text-align: center;">
                      Verify Email Address
                    </a>
                  </td>
                </tr>
              </table>
              
              <p style="margin-top: 0; margin-bottom: 16px; color: #6b7280; font-size: 14px; line-height: 22px;">
                This verification link is valid for 24 hours. If you did not create an account, you can safely disregard this message.
              </p>
              
              <hr style="border: 0; border-top: 1px solid #2e2e38; margin: 32px 0 24px 0;">
              
              <!-- Fallback Link -->
              <p style="margin-top: 0; margin-bottom: 0; color: #6b7280; font-size: 12px; line-height: 18px; word-break: break-all;">
                If the button above doesn't work, copy and paste this URL into your browser:<br>
                <a href="{{verifyLink}}" target="_blank" style="color: #fb2c36; text-decoration: underline;">{{verifyLink}}</a>
              </p>
            </td>
          </tr>
        </table>
        
        <!-- Footer -->
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; text-align: center; margin-top: 24px;">
          <tr>
            <td>
              <p style="margin: 0; color: #4b5563; font-size: 12px; line-height: 18px;">
                &copy; {{year}} JV Mastery Academy. All rights reserved.
              </p>
            </td>
          </tr>
        </table>
        
      </td>
    </tr>
  </table>
</body>
</html>