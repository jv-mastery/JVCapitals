<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Password Has Been Changed</title>
</head>
<body style="margin: 0; padding: 0; background-color: #121214; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; width: 100% !important;">
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #121214; padding: 40px 20px;">
    <tr>
      <td align="center">
        <!-- Main Card -->
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; background-color: #1e1e24; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);">
          
          <!-- Header Accent -->
          <tr>
            <td style="background-color: #fb2c36; height: 4px;"></td>
          </tr>
          
          <!-- Body Content -->
          <tr>
            <td style="padding: 40px 32px;">
              <h2 style="margin-top: 0; margin-bottom: 16px; color: #ffffff; font-size: 24px; font-weight: 700; line-height: 32px;">Password Changed Successfully</h2>
              
              <p style="margin-top: 0; margin-bottom: 24px; color: #9ca3af; font-size: 16px; line-height: 24px;">
                Hi {{name}},
              </p>
              
              <p style="margin-top: 0; margin-bottom: 24px; color: #9ca3af; font-size: 16px; line-height: 24px;">
                This email confirms that the password for your account has been successfully updated. You can now use your new password to log in.
              </p>

              <!-- Security Warning Box -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 24px;">
                <tr>
                  <td style="background-color: #1a1a1f; border-left: 4px solid #fb2c36; border-radius: 4px; padding: 16px 20px;">
                    <p style="margin: 0; color: #ffffff; font-size: 14px; font-weight: 600; line-height: 20px; margin-bottom: 4px;">
                      Didn't change your password?
                    </p>
                    <p style="margin: 0; color: #9ca3af; font-size: 14px; line-height: 20px;">
                      If you did not request this modification, your account safety may be at risk. Please lock your account and contact support immediately.
                    </p>
                  </td>
                </tr>
              </table>
              
              <!-- Action Button -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
                <tr>
                  <td align="center" style="background-color: #2e2e38; border-radius: 6px;">
                    <a href="{{supportLink}}" target="_blank" style="display: inline-block; padding: 12px 24px; font-size: 14px; font-weight: 600; color: #ffffff; text-decoration: none; text-align: center;">
                      Contact Support
                    </a>
                  </td>
                </tr>
              </table>
              
              <p style="margin-top: 0; margin-bottom: 0; color: #6b7280; font-size: 14px; line-height: 22px;">
                For security reasons, details like your old password or physical location are not explicitly listed in this notice.
              </p>
            </td>
          </tr>
        </table>
        
        <!-- Footer -->
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; text-align: center; margin-top: 24px;">
          <tr>
            <td>
              <p style="margin: 0; color: #4b5563; font-size: 12px; line-height: 18px;">
                &copy; {{year}} JV Mastery Academy. All rights reserved.
              </p>
            </td>
          </tr>
        </table>
        
      </td>
    </tr>
  </table>
</body>
</html>